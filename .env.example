# Copy this file to .env for local development. Never commit the copy.
# uv can load it with: uv run --env-file .env <command>

JUUS_ENV=development
JUUS_MODEL_BASE_URL=https://model-gateway.example.invalid/v1
JUUS_MODEL_API_KEY=replace-with-a-local-secret
JUUS_MODEL_NAME=replace-with-a-model-name
JUUS_DATABASE_URL=sqlite:///data/juus.sqlite3
