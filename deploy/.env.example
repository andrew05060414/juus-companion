# ==============================================================================
# 啾信 Juus Companion - 生产与自部署环境变量模板
# 复制本文件为 .env 并按需修改；切勿将含有真实密钥的 .env 提交至 Git 仓库！
# ==============================================================================

# 服务运行环境 (production / development)
JUUS_ENV=production

# 啾信大脑监听端口 (宿主机暴露端口)
JUUS_PORT=8000

# 大模型网关配置 (支持 9router, OneAPI, OpenAI, Ollama 等 OpenAI 兼容接口)
MODEL_GATEWAY_BASE_URL=https://api.your-model-gateway.example/v1
MODEL_GATEWAY_API_KEY=your_actual_api_key_here
DEFAULT_MODEL=deepseek-chat

# 数据库连接 (默认使用 SQLite 持久化)
DATABASE_URL=sqlite:////app/data/juus.db

# 角色卡与世界书挂载目录 (本地 data/personas 目录生成物)
PERSONA_DIR=/app/data/personas

# 推送通道 1: FCM 配置 (Firebase Cloud Messaging，需配置 service-account.json 路径)
FCM_CREDENTIALS_FILE=/app/secrets/fcm-service-account.json

# 推送通道 2: ntfy 推送服务 (自建或官方 ntfy 服务器)
NTFY_PORT=8080
NTFY_SERVER_URL=http://juus-ntfy:80
NTFY_TOPIC_PREFIX=juus_commander

# 安全与令牌有效期 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

